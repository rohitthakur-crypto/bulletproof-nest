generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
//////////////////// ENUMS ///////////////////////////
//////////////////////////////////////////////////////
enum EntityStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
  META
}

enum OtpType {
  EMAIL_VERIFICATION
  LOGIN
  PASSWORD_RESET
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum RefreshTokenStatus {
  ACTIVE
  USED
  REVOKED
}

enum DeviceType {
  MOBILE
  DESKTOP
  TABLET
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  PASSWORD_RESET
}

enum WorkspaceMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum SocialProvider {
  META
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  WHATSAPP
}

enum SocialAccountStatus {
  ACTIVE
  DISCONNECTED
  EXPIRED
  REVOKED
}

enum SocialAccountSyncStatus {
  PENDING
  SYNCING
  ACTIVE
  FAILED
  DISCONNECTED
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AutomationTriggerType {
  COMMENT_KEYWORD
  DM_KEYWORD
  STORY_MENTION
  WEBHOOK
  COMMENT_CREATED
  MESSAGE_RECEIVED
  MENTION_CREATED
  MANUAL
}

enum AutomationExecutionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum ConversationStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  TEMPLATE
}

//////////////////////////////////////////////////////
//////////////////// USERS ///////////////////////////
//////////////////////////////////////////////////////

model User {
  id String @id @default(uuid()) @db.Uuid

  name String

  email String @unique

  avatar String?

  isEmailVerified Boolean @default(false)

  lastActiveAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  credential UserCredential?

  authProviders UserAuthProviderAccount[]

  sessions UserSession[]

  refreshTokens UserRefreshToken[]

  otpCodes UserOtpCode[]

  verificationTokens UserVerificationToken[]

  memberships WorkspaceMember[]

  createdAutomations Automation[] @relation("AutomationCreatedBy")

  @@index([email])
}

//////////////////////////////////////////////////////
//////////////////// USER CREDENTIALS ////////////////
//////////////////////////////////////////////////////

model UserCredential {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid

  passwordHash String

  passwordChangedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////////
//////////////////// USER SESSIONS ///////////////////
//////////////////////////////////////////////////////

model UserSession {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  status SessionStatus @default(ACTIVE)

  deviceId String

  deviceName String?

  deviceType DeviceType?

  platform DevicePlatform?

  osVersion String?

  appVersion String?

  userAgent String?

  fcmToken String?

  ipAddress String?

  country String?

  region String?

  city String?

  loginAt DateTime @default(now())

  lastActivityAt DateTime?

  expiresAt DateTime

  revokedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokens UserRefreshToken[]

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

//////////////////////////////////////////////////////
//////////////////// USER REFRESH TOKENS //////////////
//////////////////////////////////////////////////////

model UserRefreshToken {
  id String @id @default(uuid()) @db.Uuid

  sessionId String @db.Uuid

  userId String @db.Uuid

  tokenFamily String

  jti String @unique

  tokenHash String

  status RefreshTokenStatus @default(ACTIVE)

  expiresAt DateTime

  createdAt DateTime @default(now())

  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
  @@index([tokenFamily])
  @@index([expiresAt])
}

//////////////////////////////////////////////////////
//////////////////// USER OTP CODES ///////////////////
//////////////////////////////////////////////////////

model UserOtpCode {
  id String @id @default(uuid()) @db.Uuid

  userId String? @db.Uuid

  email String

  code String

  type OtpType

  expiresAt DateTime

  verifiedAt DateTime?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([type])
  @@index([expiresAt])
}

//////////////////////////////////////////////////////
//////////////////// USER VERIFICATION TOKENS ////////
//////////////////////////////////////////////////////

model UserVerificationToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  type VerificationTokenType

  tokenHash String

  expiresAt DateTime

  usedAt DateTime?

  metadata Json?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([expiresAt])
}

//////////////////////////////////////////////////////
//////////////////// USER AUTH PROVIDER ACCOUNTS ////
//////////////////////////////////////////////////////

model UserAuthProviderAccount {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  provider AuthProvider

  providerId String

  accessToken String?

  refreshToken String?

  tokenExpiresAt DateTime?

  scope String?

  idToken String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@index([provider])
}

//////////////////////////////////////////////////////
//////////////// ADMINS ///////////////////////////////
//////////////////////////////////////////////////////

model Admin {
  id String @id @default(uuid()) @db.Uuid

  name String

  email String @unique

  avatar String?

  isActive Boolean @default(true)

  lastLoginAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  credential AdminCredential?

  roles AdminRoleAssignment[]

  sessions AdminSession[]

  refreshTokens AdminRefreshToken[]

  passwordResetTokens AdminPasswordResetToken[]

  @@index([email])
}

//////////////////////////////////////////////////////
//////////////////// ADMIN CREDENTIALS ///////////////
//////////////////////////////////////////////////////

model AdminCredential {
  id String @id @default(uuid()) @db.Uuid

  adminId String @unique @db.Uuid

  passwordHash String

  passwordChangedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////////
//////////////////// ADMIN ROLES /////////////////////
//////////////////////////////////////////////////////

model AdminRole {
  id String @id @default(uuid()) @db.Uuid

  name String @unique

  description String?

  isSystem Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  permissions AdminRolePermission[]

  admins AdminRoleAssignment[]
}

model AdminPermission {
  id String @id @default(uuid()) @db.Uuid

  resource String

  action String

  key String @unique

  description String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  roles AdminRolePermission[]

  @@unique([resource, action])
}

//////////////////////////////////////////////////////
//////////////// ADMIN ROLE PERMISSIONS /////////////
//////////////////////////////////////////////////////

model AdminRolePermission {
  id String @id @default(uuid()) @db.Uuid

  roleId String @db.Uuid

  permissionId String @db.Uuid

  role AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}
model AdminRoleAssignment {
  id String @id @default(uuid()) @db.Uuid

  adminId String @db.Uuid

  roleId String @db.Uuid

  assignedAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  role AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([adminId, roleId])
}
model AdminSession {
  id String @id @default(uuid()) @db.Uuid

  adminId String @db.Uuid

  status SessionStatus @default(ACTIVE)

  deviceId String

  deviceName String?

  deviceType DeviceType?

  platform DevicePlatform?

  osVersion String?

  appVersion String?

  userAgent String?

  fcmToken String?

  ipAddress String?

  country String?

  region String?

  city String?

  loginAt DateTime @default(now())

  lastActivityAt DateTime?

  expiresAt DateTime

  revokedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  refreshTokens AdminRefreshToken[]

  @@unique([adminId, deviceId])
  @@index([adminId])
  @@index([status])
  @@index([expiresAt])
}
model AdminRefreshToken {
  id String @id @default(uuid()) @db.Uuid

  sessionId String @db.Uuid

  adminId String @db.Uuid

  tokenFamily String

  jti String @unique

  tokenHash String

  status RefreshTokenStatus @default(ACTIVE)

  expiresAt DateTime

  createdAt DateTime @default(now())

  session AdminSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([adminId])
  @@index([expiresAt])
}

model AdminPasswordResetToken {
  id String @id @default(uuid()) @db.Uuid

  adminId String @db.Uuid

  tokenHash String

  expiresAt DateTime

  usedAt DateTime?

  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

//////////////////////////////////////////////////////
//////////////////// WORKSPACES //////////////////////
//////////////////////////////////////////////////////

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  logo      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members            WorkspaceMember[]
  socialAccounts     SocialAccount[]
  automations        Automation[]
  automationExecutions AutomationExecution[]
  webhookEvents      WebhookEvent[]
  posts              SocialPost[]

  @@index([slug])
}
model WorkspaceMember {
  id           String @id @default(uuid()) @db.Uuid

  workspaceId  String @db.Uuid
  userId       String @db.Uuid

  role WorkspaceMemberRole @default(MEMBER)

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
}


//////////////////////////////////////////////////////
//////////////////// SOCIAL ACCOUNTS /////////////////
//////////////////////////////////////////////////////

model SocialAccount {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String @db.Uuid

  platform SocialPlatform

  platformAccountId String // pageId / igId / waId

  metaPageId String?

  accountName    String
  username       String?
  profilePicture String?

  status SocialAccountStatus @default(ACTIVE)

  webhookSubscribed   Boolean   @default(false)
  webhookSubscribedAt DateTime?
  webhookFields       String[]  @default([])

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  credentials   SocialCredential?
  posts         SocialPost[]
  syncState     SocialPostSyncState?
  automations   Automation[]
  contacts      Contact[]
  conversations Conversation[]
  messages      Message[]
  webhookEvents WebhookEvent[]

  @@unique([workspaceId, platform, platformAccountId])
  @@index([workspaceId])
}
model SocialCredential {
  id String @id @default(uuid()) @db.Uuid

  socialAccountId String @unique @db.Uuid

  accessToken String

  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([socialAccountId])
  @@index([expiresAt])
}

//////////////////////////////////////////////////////
//////////////////// SOCIAL POSTS ////////////////////
//////////////////////////////////////////////////////

model SocialPost {
  id String @id @default(uuid()) @db.Uuid

  workspaceId     String @db.Uuid
  socialAccountId String @db.Uuid

  platform       SocialPlatform
  platformPostId String

  caption      String?
  mediaType    String?
  mediaUrl     String?
  thumbnailUrl String?
  permalink    String?

  publishedAt DateTime?
  lastSeenAt  DateTime?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, platformPostId])
  @@index([socialAccountId, publishedAt])
  @@index([workspaceId])
  @@index([isDeleted])
}

//////////////////////////////////////////////////////
/////////////// SOCIAL POST SYNC STATE ///////////////
//////////////////////////////////////////////////////

model SocialPostSyncState {
  id String @id @default(uuid()) @db.Uuid

  socialAccountId String @unique @db.Uuid

  nextCursor String?

  hasMore Boolean @default(true)

  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////////
//////////////////// CONTACTS ////////////////////////
//////////////////////////////////////////////////////

model Contact {
  id String @id @default(uuid()) @db.Uuid

  socialAccountId String @db.Uuid

  externalContactId String

  name String?
  username String?
  profilePicture String?

  tags String[]
  metadata Json?

  lastInteractionAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  conversations Conversation[]
  messages      Message[]

  @@index([socialAccountId, externalContactId])
}

//////////////////////////////////////////////////////
//////////////// CONVERSATIONS ///////////////////////
//////////////////////////////////////////////////////

model Conversation {
  id String @id @default(uuid()) @db.Uuid

  socialAccountId String @db.Uuid
  contactId       String @db.Uuid

  status ConversationStatus @default(OPEN)

  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  contact       Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)

  messages Message[]

  @@index([socialAccountId, contactId])
}

//////////////////////////////////////////////////////
//////////////////// MESSAGES ////////////////////////
//////////////////////////////////////////////////////

model Message {
  id String @id @default(uuid()) @db.Uuid

  socialAccountId String @db.Uuid
  conversationId  String @db.Uuid
  contactId       String @db.Uuid

  externalMessageId String?

  direction MessageDirection
  type      MessageType

  content     String?
  attachments Json?
  metadata    Json?

  sentAt DateTime?

  createdAt DateTime @default(now())

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  conversation  Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact       Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([externalMessageId])
}



//////////////////////////////////////////////////////
//////////////// AUTOMATIONS /////////////////////////
//////////////////////////////////////////////////////

model Automation {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String @db.Uuid
  socialAccountId String @db.Uuid
  createdById String @db.Uuid

  name String
  description String?

  status AutomationStatus @default(DRAFT)

  triggerType AutomationTriggerType
  triggerConfig Json

  flowData Json?

  isAiEnabled Boolean @default(false)

  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  createdBy User @relation("AutomationCreatedBy", fields: [createdById], references: [id])

  executions AutomationExecution[]

  @@index([workspaceId, status])
  @@index([socialAccountId, status])
  @@index([createdById])
  @@index([triggerType])
}

//////////////////////////////////////////////////////
//////////// AUTOMATION EXECUTIONS ///////////////////
//////////////////////////////////////////////////////

model AutomationExecution {
  id String @id @default(uuid()) @db.Uuid

  workspaceId  String @db.Uuid
  automationId String @db.Uuid

  triggerPayload Json?

  status AutomationExecutionStatus @default(PENDING)

  startedAt   DateTime?
  completedAt DateTime?

  error String?

  executedAt DateTime @default(now())

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([automationId])
  @@index([status])
  @@index([executedAt])
}

//////////////////////////////////////////////////////
//////////////////// WEBHOOK EVENTS //////////////////
//////////////////////////////////////////////////////

model WebhookEvent {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String @db.Uuid
  socialAccountId String @db.Uuid

  platform SocialPlatform

  eventType String
  externalEventId String?

  payload Json

  status String @default("PENDING")

  processedAt DateTime?

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, externalEventId])
  @@index([status])
}
